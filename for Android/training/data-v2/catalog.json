    "advertisement": {
      "type": "function",
      "function": {
        "name": "todo",
        "description": "Manage durable Todo items for the current session. Actions: list; add requires content (optional zero-based position; a new item always starts pending); update requires id and at least one of content, status (pending, in_progress, completed), or position; complete and delete require id.",
