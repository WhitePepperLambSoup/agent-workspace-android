                }
              },
              "minProperties": 1,
              "maxProperties": 5,
              "additionalProperties": false
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 100,
              "maximum": 5000
            }
          },
          "required": [
            "action",
            "snapshot_version"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "action": {
                    "const": "tap"
