                  "action": {
                    "const": "complete"
                  }
                },
                "required": [
                  "action"
                ]
              },
              "then": {
                "required": [
                  "id"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "action": {
                    "const": "delete"
                  }
                },
                "required": [
                  "action"
                ]
