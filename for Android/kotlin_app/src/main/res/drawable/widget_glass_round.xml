<?xml version="1.0" encoding="utf-8"?>
<!-- Glass round button on the wallpaper: fill, sheen and rim; a circle has no straight edge for a glint. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_glass_fill" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:type="linear"
                android:startColor="@color/widget_glass_sheen"
                android:centerColor="#00FFFFFF" android:centerY="0.5"
                android:endColor="#00FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="@color/widget_glass_rim" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</layer-list>
