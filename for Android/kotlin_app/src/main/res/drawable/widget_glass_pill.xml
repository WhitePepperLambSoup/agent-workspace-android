<?xml version="1.0" encoding="utf-8"?>
<!-- Glass quick ask field, floating on the wallpaper: the panel's layers in a pill. The glint covers only the
     straight top edge (inset by the 26dp radius); on the curve a straight line would stick out. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_glass_fill" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:type="linear"
                android:startColor="@color/widget_glass_sheen"
                android:centerColor="#00FFFFFF" android:centerY="0.5"
                android:endColor="#00FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="@color/widget_glass_rim" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:gravity="top|fill_horizontal" android:height="1dp" android:left="26dp" android:right="26dp">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:type="linear"
                android:startColor="@color/widget_glass_glint"
                android:endColor="@color/widget_glass_glint_fade" />
        </shape>
    </item>
</layer-list>
