<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- WebUiActivity theme. Light variant; values-night/themes.xml holds the dark one. -->
    <style name="Theme.AgentWorkspace" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/web_surface</item>
        <item name="android:statusBarColor">@color/web_surface</item>
        <item name="android:navigationBarColor">@color/web_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- WebView (targetSdk 33+) derives prefers-color-scheme from this flag, so the web UI's
             "follow system" option tracks the device setting. Native dialogs keep the Material theme. -->
        <!-- The web UI draws its own light and dark themes; vendor "force dark" modes (MIUI/HyperOS,
             ColorOS, MagicOS...) would otherwise invert it a second time. -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:isLightTheme" tools:targetApi="q">true</item>
        <item name="android:alertDialogTheme">@style/Theme.AgentWorkspace.Dialog</item>
    </style>

    <!-- Native dialogs (model settings and others): dark like before, but with their own solid
         panel. The default one takes the theme's floating colour, which came out transparent on
         some phones (ZTE): dialog text was drawn straight over the page. -->
    <style name="Theme.AgentWorkspace.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:colorBackgroundFloating">@color/dialog_surface</item>
        <item name="android:colorAccent">@color/dialog_accent</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <!-- The phone control panel on Android 12+: a window of its own, so the system can blur what
         lies under it. The panel draws its own glass; no dim, animation, shadow or minimum width. -->
    <style name="Theme.AgentWorkspace.PanelWindow" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowElevation">0dp</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <!-- Circle to ask: invisible while the screen is captured, then the screenshot fills it. -->
    <style name="Theme.AgentWorkspace.ScreenAsk" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>
