<?xml version="1.0" encoding="utf-8"?>
<!-- Quick tasks widget (4x2): the composer's quick tasks; each opens a new conversation with its prompt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_sparkle" />

        <TextView
            android:id="@+id/quick_tasks_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="@string/widget_quick_tasks_label"
            android:textColor="@color/widget_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/quick_tasks_new"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_field"
            android:padding="7dp"
            android:src="@drawable/ic_widget_new" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/quick_tasks_row_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/quick_task_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_tile"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/quick_task_1_title"
                android:text="@string/widget_task_summarize_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/widget_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/quick_task_1_detail"
                android:text="@string/widget_task_summarize_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/widget_text_tertiary"
                android:textSize="11.5sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/quick_task_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_tile"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/quick_task_2_title"
                android:text="@string/widget_task_translate_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/widget_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/quick_task_2_detail"
                android:text="@string/widget_task_translate_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/widget_text_tertiary"
                android:textSize="11.5sp" />
        </LinearLayout>    </LinearLayout>
    <LinearLayout
        android:id="@+id/quick_tasks_row_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/quick_task_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_tile"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/quick_task_3_title"
                android:text="@string/widget_task_web_page_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/widget_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/quick_task_3_detail"
                android:text="@string/widget_task_web_page_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/widget_text_tertiary"
                android:textSize="11.5sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/quick_task_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_tile"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/quick_task_4_title"
                android:text="@string/widget_task_analyze_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/widget_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/quick_task_4_detail"
                android:text="@string/widget_task_analyze_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/widget_text_tertiary"
                android:textSize="11.5sp" />
        </LinearLayout>    </LinearLayout></LinearLayout>