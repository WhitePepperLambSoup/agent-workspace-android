<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#202124" android:orientation="horizontal" android:padding="8dp">
    <TextView android:id="@+id/widget_open" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:gravity="center_vertical" android:text="Agent Workspace"
        android:textSize="16sp" android:textColor="#FFFFFF" android:maxLines="2" />
    <ImageButton android:id="@+id/widget_voice" android:layout_width="48dp" android:layout_height="48dp"
        android:contentDescription="Voice draft" android:src="@android:drawable/ic_btn_speak_now"
        android:background="#202124" android:tint="#FFFFFF" />
</LinearLayout>
